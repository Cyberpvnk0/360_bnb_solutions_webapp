# Copy to .env.local and fill in. .env.local is gitignored — keys never
# land in the repo. The RentCast key powers live rentals in Deal Finder;
# without it the app serves its seeded preview inventory.
RENTCAST_API_KEY=your-rentcast-key

# NO APP-WIDE CAPS UNLESS YOU SET THEM. The only limits a student meets
# are their plan's (credits a month, per account; a market search or a
# property analysis spends one, the first time). Every
# variable below marked "brake" is optional: unset, the vendor is asked
# whenever a plan allows it; set, it holds the day's spend to a figure.
#
# Brake: RentCast's plan in requests per MONTH. The feed's daily cap is
# derived from it, spread over 31 days and never under one.
# RENTCAST_DAILY_CAP overrides the arithmetic outright.
# RENTCAST_MONTHLY_REQUESTS=50

# Brake: distinct live searches per day for the OTHER per-area vendors —
# the furnished search, STR market pulls, comps. Repeat searches of the
# same area are cached and free; failed requests never count.
# LIVE_SEARCH_DAILY_CAP=50

# Optional: Google Maps key for Street View of a live listing's address
# — the kerb, never the listing's own photos, which this product does
# not fetch, store or show. Server-side only — the browser never sees
# it; images proxy through /api/property-image and cache for 30 days
# per address. A free metadata probe checks imagery exists before any
# billed image request.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: Mapbox token for the aerial that stands in when Street View
# has no imagery for an address (or the Google key is absent). Static
# Images are free to 50k requests a month. Server-side only; without
# it a card with no Street View shows the seeded sketch, tagged.
MAPBOX_TOKEN=your-mapbox-token

# Optional: distinct addresses given a Street View shot per day
# (default 1000, roughly $7 at their per-image rate). This is the SOFT
# ceiling; the hard one is the daily quota on the Street View Static
# API in the Cloud console, and both should be set. The difference is
# what happens at the limit: Google refuses the request, while this
# declines to make it, so a card falls straight to its aerial instead
# of waiting on a round trip to be told no. Counted per address rather
# than per view, because Google's answer caches for 30 days and is
# shared across everyone on the deployment — a market browsed all
# afternoon spends its addresses once.
# Brake, unset by default: Google's own quota is then the only stop.
# IMAGERY_DAILY_CAP=1000

# Optional: which geocoder is asked first, "google" (default) or
# "census". This is an accuracy-for-money trade and the reason it is a
# variable. The US Census geocoder is free and keyless but interpolates
# along a street segment rather than locating the parcel, landing ten to
# fifty metres out — which is exactly what decides whether a kerb shot
# frames this house or the one next door. Google is asked first for that
# reason; Census catches what it misses, and still answers everything if
# no Google key is set. Only rows that arrive without coordinates are
# geocoded at all, and every answer caches for 30 days.
GEOCODER_PRIMARY=google

# Optional: AirROI key for live short-term-rental comps and market
# analytics (pay-as-you-go, ~$0.01+/call). Server-side only. Without it
# the analyzer uses its seeded comp set and labels it "Preview comps".
AIRROI_API_KEY=your-airroi-key

# Optional: ScraperAPI key for the Furnished filter on LIVE rows. Rental
# feeds ship no amenity field, so a furnished-filtered search is run on
# a listing site through this vendor — one billed request per result
# page, no listing pages opened, no photos fetched. What is kept is the
# search's own rows: address, rent, size, and the fact that the unit
# is furnished. Listing prose is never stored or displayed.
SCRAPERAPI_KEY=your-scraperapi-key

# Optional: DataSkip key for the deep phone lookup — a public-records
# search for a property's owner and their number, offered in the Deal
# Finder only when no listing page gave a number. Billed per match
# (four cents; a miss is free, no monthly fee); one vendor request per
# address ever (answers cache 30 days, no-matches 7); the account pays
# PHONE_LOOKUP_CREDITS (config/app) only when a number comes back.
# Server-side only. Without it the button says the lookup isn't set up.
# The endpoint can be overridden if the vendor moves it.
# DataSkip_Key=pc_your-dataskip-key
# DATA_SKIP_API_URL=https://app.dataskip.io/api/v1/skip-trace

# Optional: ceiling on properties read per day (default 200) by the
# description miner at /api/enrich — kept and tested, not wired into
# the UI (see README). This is the spend guard for that path — unlike
# search, every address is its own billed call. A protected page costs ~11 credits on the cheap
# path and several times that when it needs JS rendering, so 200 is
# roughly 2k–15k credits/day. Tune it once a probe run
# (/api/enrich?probe=jacksonville&n=25) reports the real number.
# Brake, unset by default.
# SCRAPERAPI_DAILY_ENRICH_CAP=200

# Optional: where the request-tier ladder starts and stops.
# Measured: the standard tier is served Zillow's anti-bot interstitial
# on every address, so `premium` is the honest floor — starting lower
# just spends a credit to be told no. `ultra` adds the heaviest proxies
# plus JS rendering and costs many times more, so MAX_TIER is the spend
# ceiling; set it to `premium` to refuse the expensive retry entirely.
SCRAPERAPI_TIER=premium
SCRAPERAPI_MAX_TIER=ultra

# Optional: concurrent reads. Match your plan's thread limit — 5 on the
# free trial, more on paid tiers. Above it the vendor answers 429s.
SCRAPERAPI_CONCURRENCY=5

# Optional: how many Redfin result pages to follow (default 4, max 10).
# Redfin paginates at ~41 rows and hands back next-page links; reading
# only the first page shows a third of a market and looks like a
# narrower search than the one that ran. Each page is its own billed
# request (~10 credits), so this is the ceiling on a market's cost.
REDFIN_MAX_PAGES=4

# DEMO CHECKOUT. Nothing in the product takes a card yet. With this set,
# "Choose plan" writes the tier for real and the pack buttons grant
# credits for real — with no payment behind either. That is what makes
# testing possible and what makes leaving it on in production a way to
# hand out plans for free. Unset it before students arrive; a processor's
# webhook (Whop) becomes the thing that sets tiers and grants packs.
MOCK_CHECKOUT=0

# OPTIONAL: staff list. Leave this unset and every signed-in account
# is staff — sees /admin and its figures. Set it to a comma-separated
# list of emails to draw the line: only those accounts do, everyone else
# gets a 404 from /admin. Matched case-insensitively against the
# account's email.
#
# The DIAGNOSTIC routes that spend vendor money outside every meter
# (/api/str, /api/enrich, the ?shape= probes, /api/redfin/cities, the
# Street View ?check=) are never open by default: they need an email
# NAMED here with a confirmed address, or a request carrying
# CRON_SECRET (?secret= or a Bearer token). Unset both and they answer
# 503 rather than spending anything.
# ADMIN_EMAILS=you@example.com,staff@example.com

# ADDRESS SUGGESTIONS. Every address box suggests up to five addresses as
# you type (street, city, state, ZIP), through the first of these that
# answers: the Mapbox token above (Geocoding v6 autocomplete: one call
# returns the address AND its coordinates; 100k requests a month free),
# then the Google key above (Places Autocomplete — enable "Places API
# (New)" on the key; billed per request, no ZIP, one geocode on pick),
# then the free Census geocoder, which only matches complete addresses.
# SUGGEST_DAILY_CAP is a brake on the billed providers per day (unset by
# default); past it, suggestions fall back to Census for the rest of
# the day.
# SUGGEST_DAILY_CAP=20000

# The research assistant (Claude Sonnet, via the Anthropic SDK). The SDK
# reads this exact name; without it the assistant answers "not set up".
# ANTHROPIC_API_KEY=sk-ant-your-key
# Only for a key scoped to the whole organization: the workspace it
# should bill to (Console, Settings, Workspaces). A key created inside
# a workspace needs no such thing.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id

# New-listing alerts. Mail goes through Resend (RESEND_API_KEY, and a
# sender on a domain verified there); push goes through Web Push with a
# VAPID key pair (`npx web-push generate-vapid-keys`) and a contact.
# NEXT_PUBLIC_APP_URL is the address links in the mail point back to.
# RESEND_API_KEY=re_your-key
# ALERTS_FROM=AirCore <alerts@yourdomain.com>
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
# NEXT_PUBLIC_APP_URL=https://360-bnb-solutions-webapp.vercel.app

# The basemap's dark twin, when dark mode should draw a different map
# than the "-dark" of MAPTILER_MAP (dataviz-light -> dataviz-dark).
# MAPTILER_MAP_DARK=streets-v2-dark
# MAP_STYLE_URL_DARK=https://example.com/dark-style.json
