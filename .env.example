# Copy to .env.local and fill in. .env.local is gitignored — keys never
# land in the repo. The RentCast key powers live rentals in Deal Finder;
# without it the app serves its seeded preview inventory.
RENTCAST_API_KEY=your-rentcast-key

# Optional: distinct live searches allowed per day (default 50 —
# RentCast free tier). Repeat searches of the same area are cached and
# free; failed requests never count.
LIVE_SEARCH_DAILY_CAP=50

# Optional: Google Maps key for Street View of a live listing's address
# — the kerb, never the listing's own photos, which this product does
# not fetch, store or show. Server-side only — the browser never sees
# it; images proxy through /api/property-image and cache for 30 days
# per address. A free metadata probe checks imagery exists before any
# billed image request.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: Mapbox token for the aerial that stands in when Street View
# has no imagery for an address (or the Google key is absent). Static
# Images are free to 50k requests a month. Server-side only; without
# it a card with no Street View shows the seeded sketch, tagged.
MAPBOX_TOKEN=your-mapbox-token

# Optional: distinct addresses given a Street View shot per day
# (default 1000, roughly $7 at their per-image rate). This is the SOFT
# ceiling; the hard one is the daily quota on the Street View Static
# API in the Cloud console, and both should be set. The difference is
# what happens at the limit: Google refuses the request, while this
# declines to make it, so a card falls straight to its aerial instead
# of waiting on a round trip to be told no. Counted per address rather
# than per view, because Google's answer caches for 30 days and is
# shared across everyone on the deployment — a market browsed all
# afternoon spends its addresses once.
IMAGERY_DAILY_CAP=1000

# Optional: AirROI key for live short-term-rental comps and market
# analytics (pay-as-you-go, ~$0.01+/call). Server-side only. Without it
# the analyzer uses its seeded comp set and labels it "Preview comps".
AIRROI_API_KEY=your-airroi-key

# Optional: ScraperAPI key for the Furnished filter on LIVE rows. Rental
# feeds ship no amenity field, so a furnished-filtered search is run on
# a listing site through this vendor — one billed request per result
# page, no listing pages opened, no photos fetched. What is kept is the
# search's own rows: address, rent, size, and the fact that the unit
# is furnished. Listing prose is never stored or displayed.
SCRAPERAPI_KEY=your-scraperapi-key

# Optional: ceiling on properties read per day (default 200) by the
# description miner at /api/enrich — kept and tested, not wired into
# the UI (see README). This is the spend guard for that path — unlike
# search, every address is its own billed call. A protected page costs ~11 credits on the cheap
# path and several times that when it needs JS rendering, so 200 is
# roughly 2k–15k credits/day. Tune it once a probe run
# (/api/enrich?probe=jacksonville&n=25) reports the real number.
SCRAPERAPI_DAILY_ENRICH_CAP=200

# Optional: where the request-tier ladder starts and stops.
# Measured: the standard tier is served Zillow's anti-bot interstitial
# on every address, so `premium` is the honest floor — starting lower
# just spends a credit to be told no. `ultra` adds the heaviest proxies
# plus JS rendering and costs many times more, so MAX_TIER is the spend
# ceiling; set it to `premium` to refuse the expensive retry entirely.
SCRAPERAPI_TIER=premium
SCRAPERAPI_MAX_TIER=ultra

# Optional: concurrent reads. Match your plan's thread limit — 5 on the
# free trial, more on paid tiers. Above it the vendor answers 429s.
SCRAPERAPI_CONCURRENCY=5

# Optional: how many Redfin result pages to follow (default 4, max 10).
# Redfin paginates at ~41 rows and hands back next-page links; reading
# only the first page shows a third of a market and looks like a
# narrower search than the one that ran. Each page is its own billed
# request (~10 credits), so this is the ceiling on a market's cost.
REDFIN_MAX_PAGES=4
