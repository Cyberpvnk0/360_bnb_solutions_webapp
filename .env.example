# Copy to .env.local and fill in. .env.local is gitignored — keys never
# land in the repo. The RentCast key powers live rentals in Deal Finder;
# without it the app serves its seeded preview inventory.
RENTCAST_API_KEY=your-rentcast-key

# Optional: distinct live searches allowed per day (default 50 —
# RentCast free tier). Repeat searches of the same area are cached and
# free; failed requests never count.
LIVE_SEARCH_DAILY_CAP=50

# Optional: Google Maps key for curb-view photos on live listings.
# Server-side only — the browser never sees it; images proxy through
# /api/street-view and cache for 30 days per address. A free metadata
# probe checks imagery exists before any billed image request.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: AirROI key for live short-term-rental comps and market
# analytics (pay-as-you-go, ~$0.01+/call). Server-side only. Without it
# the analyzer uses its seeded comp set and labels it "Preview comps".
AIRROI_API_KEY=your-airroi-key

# Optional: ScraperAPI key for amenity enrichment — the data behind the
# Furnished filter on LIVE rows. Rental feeds ship no amenity field, so
# the flags are mined from each listing's own page, on demand, only for
# rows on screen, and only once a student actually asks for a feature.
# Only FLAGS are kept: the page text is never stored or displayed.
SCRAPERAPI_KEY=your-scraperapi-key

# Optional: ceiling on properties read per day (default 200). This is
# the real spend guard for enrichment — unlike search, every address is
# its own billed call. A protected page costs ~11 credits on the cheap
# path and several times that when it needs JS rendering, so 200 is
# roughly 2k–15k credits/day. Tune it once a probe run
# (/api/enrich?probe=jacksonville&n=25) reports the real number.
SCRAPERAPI_DAILY_ENRICH_CAP=200

# Optional: where the request-tier ladder starts and stops.
# Measured: the standard tier is served Zillow's anti-bot interstitial
# on every address, so `premium` is the honest floor — starting lower
# just spends a credit to be told no. `ultra` adds the heaviest proxies
# plus JS rendering and costs many times more, so MAX_TIER is the spend
# ceiling; set it to `premium` to refuse the expensive retry entirely.
SCRAPERAPI_TIER=premium
SCRAPERAPI_MAX_TIER=ultra

# Optional: concurrent reads. Match your plan's thread limit — 5 on the
# free trial, more on paid tiers. Above it the vendor answers 429s.
SCRAPERAPI_CONCURRENCY=5

# Optional: how many Redfin result pages to follow (default 4, max 10).
# Redfin paginates at ~41 rows and hands back next-page links; reading
# only the first page shows a third of a market and looks like a
# narrower search than the one that ran. Each page is its own billed
# request (~10 credits), so this is the ceiling on a market's cost.
REDFIN_MAX_PAGES=4
